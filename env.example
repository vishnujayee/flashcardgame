# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# --- MongoDB ---
MONGODB_URI=
MONGODB_DB=flashcardfrenzy

# --- App Config ---
# Default number of flashcards per match (1-50)
MATCH_SIZE=10

# --- Security ---
# Used to sign guest session cookies
APP_SECRET=

# --- Admin ---
# Comma-separated email allowlist for admin access to /admin
ADMIN_EMAILS=

# --- Rate Limiting ---
# Requests per window for matchmaking
RL_WINDOW_MS=60000
RL_MAX=30

# --- Matchmaking Rules ---
# If true, avoid matching players from the same IP
BLOCK_SAME_IP=false
